# Copy this file to .env for local development overrides.
# Docker Compose also ships with inline defaults, so the stack validates without a .env file.

APP_HOST=0.0.0.0
APP_PORT=8000
# SvelteKit frontend defaults. The committed production adapter is Node server
# output for temporary/staging deploys: run `pnpm build && pnpm start` in frontend/.
# adapter-node reads HOST and PORT for the frontend process.
HOST=0.0.0.0
PORT=3000
# Public frontend origin when the Node server is behind a reverse proxy.
ORIGIN=http://localhost:3000
# Private backend origin reachable from the frontend SSR server.
API_BASE_URL=http://localhost:8000

# App image tags used by containerized E2E/production Compose examples.
MEMEXPERT_MAIN_IMAGE=memexpert-main:local
MEMEXPERT_WORKER_IMAGE=memexpert-worker:local
MEMEXPERT_FRONTEND_IMAGE=memexpert-frontend:local
MEMEXPERT_E2E_RUNNER_IMAGE=memexpert-e2e-runner:local

DATABASE_URL=postgresql+asyncpg://memexpert:memexpert@localhost:5432/memexpert
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://memexpert:memexpert@localhost:5672/
QDRANT_URL=http://localhost:6333
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=memexpert-dev-key
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=memexpert
S3_SECRET_KEY=memexpert-secret
S3_BUCKET=memexpert
S3_REGION=us-east-1
# Internal/local imgproxy base used by backend services and as the local fallback for rendered image URLs.
IMGPROXY_BASE_URL=http://localhost:8080
# Optional browser/CDN/reverse-proxy imgproxy origin for rendered public image URLs.
# Leave blank locally to use IMGPROXY_BASE_URL; set in production when IMGPROXY_BASE_URL is compose-internal.
IMGPROXY_PUBLIC_BASE_URL=
# Leave key/salt empty for unsigned local imgproxy /unsafe URLs. Configure both in production.
IMGPROXY_KEY=
IMGPROXY_SALT=
# Optional browser-reachable public file-id CDN/API base used for web-video MP4 delivery, e.g. https://media.memexpert.net/files
MEDIA_PUBLIC_BASE_URL=
IMGPROXY_PORT=8080

# Content-pipeline settings. Keep the operator token out of client-side configs.
PIPELINE_OPERATOR_TOKEN=memexpert-dev-pipeline-operator-token-min-32
PIPELINE_UPLOAD_MAX_BYTES=20971520
PIPELINE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif
PIPELINE_PHASH_SIZE=16
PIPELINE_IMAGE_MAX_PIXELS=45000000
PIPELINE_S3_ORIGINAL_PREFIX=pipeline/originals
PIPELINE_S3_DERIVATIVE_PREFIX=pipeline/derived
PIPELINE_BROKER_EXCHANGE=memexpert.pipeline
PIPELINE_BROKER_ROUTING_KEY_PREFIX=pipeline
PIPELINE_BROKER_TRANSCODE_QUEUE=pipeline.transcode
PIPELINE_BROKER_RETRY_EXCHANGE=memexpert.pipeline.retry
PIPELINE_BROKER_RETRY_QUEUE=pipeline.retry
PIPELINE_BROKER_DEAD_LETTER_EXCHANGE=memexpert.pipeline.dlx
PIPELINE_BROKER_DEAD_LETTER_QUEUE=pipeline.dlq
PIPELINE_BROKER_RETRY_MAX_ATTEMPTS=5
PIPELINE_BROKER_RETRY_BACKOFF_SECONDS=5.0
PIPELINE_BROKER_CONNECTION_TIMEOUT_SECONDS=5.0
PIPELINE_WORKER_PREFETCH_COUNT=1
PIPELINE_STORAGE_CONNECTION_TIMEOUT_SECONDS=5.0
PIPELINE_WORKER_FAIL_TRANSCODE_FOR_MEME_FILE_ID=
PIPELINE_WORKER_FAIL_EMBED_FOR_MEME_FILE_ID=
PIPELINE_WORKER_FAIL_CLASSIFY_FOR_MEME_FILE_ID=

# Heavy-worker embed/classify adapter settings. Leave secret/URL values blank locally so
# the real providers cannot be hit from tests; the pytest suites inject deterministic fakes.
PIPELINE_OCR_PROVIDER_MODE=live
PIPELINE_OCR_PRIMARY_ENGINE=paddleocr
# Worker image default: /opt/paddleocr-venv/bin/python /app/scripts/paddleocr_json.py --input {input}
PIPELINE_OCR_PADDLE_COMMAND=
PIPELINE_OCR_FALLBACK_ENGINE=
PIPELINE_OCR_FALLBACK_COMMAND=
PIPELINE_OCR_TIMEOUT_SECONDS=30.0
PIPELINE_OCR_LOW_CONFIDENCE_THRESHOLD=0.6
PIPELINE_FAKE_OCR_TEXT=cat e2e smoke fake ocr text
PIPELINE_VOYAGE_MODEL=voyage-multimodal-3.5
PIPELINE_VOYAGE_OUTPUT_DIMENSIONS=1024
PIPELINE_VOYAGE_API_URL=https://api.voyageai.com/v1/multimodalembeddings
PIPELINE_VOYAGE_API_KEY=
PIPELINE_VOYAGE_TIMEOUT_SECONDS=30.0
PIPELINE_QDRANT_COLLECTION_NAME=memexpert-memes
PIPELINE_QDRANT_SEARCH_TOP_K=5
PIPELINE_QDRANT_TIMEOUT_SECONDS=10.0
PIPELINE_MERGE_SIMILARITY_THRESHOLD=0.92
PIPELINE_CLASSIFICATION_API_URL=
PIPELINE_CLASSIFICATION_API_KEY=
PIPELINE_CLASSIFICATION_MODEL=memexpert-nsfw-v1
PIPELINE_CLASSIFICATION_TIMEOUT_SECONDS=15.0
PIPELINE_CLASSIFICATION_NSFW_THRESHOLD=0.5
PIPELINE_SEO_PROVIDER_MODE=static
PIPELINE_SEO_MODEL=gpt-5-mini
# Leave blank to use the provider's default OpenAI base URL in live mode.
PIPELINE_SEO_API_BASE_URL=
PIPELINE_SEO_API_KEY=
PIPELINE_SEO_TIMEOUT_SECONDS=30.0
PIPELINE_SEO_MAX_ATTEMPTS=2
PIPELINE_SEO_IMAGE_MAX_BYTES=5242880
PIPELINE_SEO_PROMPT_VERSION=meme-seo-v1
PIPELINE_BROKER_OCR_QUEUE=pipeline.ocr
PIPELINE_BROKER_EMBED_QUEUE=pipeline.embed
PIPELINE_BROKER_CLASSIFY_QUEUE=pipeline.classify
PIPELINE_BROKER_SYNC_QDRANT_QUEUE=pipeline.sync_qdrant
PIPELINE_BROKER_SYNC_MEILI_QUEUE=pipeline.sync_meili
PIPELINE_BROKER_SOURCE_ENGAGEMENT_CAPTURE_QUEUE=pipeline.source_engagement_capture

# Auth/session settings. Leave provider secrets blank locally until you wire real credentials.
AUTH_JWT_SECRET=memexpert-dev-jwt-secret-with-32-byte-minimum
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_ACCESS_COOKIE_NAME=memexpert_access_token
AUTH_ACCESS_COOKIE_SECURE=true
AUTH_ACCESS_COOKIE_HTTPONLY=true
AUTH_ACCESS_COOKIE_SAMESITE=lax
AUTH_ACCESS_COOKIE_PATH=/
AUTH_ACCESS_COOKIE_DOMAIN=
AUTH_TELEGRAM_BOT_TOKEN=
AUTH_TELEGRAM_BOT_USERNAME=
AUTH_TELEGRAM_LOGIN_MAX_AGE_SECONDS=300
AUTH_TELEGRAM_MINIAPP_MAX_AGE_SECONDS=300
AUTH_TELEGRAM_LINK_CODE_TTL_SECONDS=600
AUTH_TELEGRAM_LINK_RETURN_URL=
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URI=
AUTH_GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
AUTH_GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
AUTH_GOOGLE_TIMEOUT_SECONDS=10.0

# Shared API security settings.
SECURITY_CORS_ALLOWED_ORIGINS=https://memexpert.net,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://web.telegram.org,https://oauth.telegram.org
SECURITY_CORS_ALLOWED_ORIGIN_REGEX=^https://([a-z0-9-]+\.)?memexpert\.net$
SECURITY_CORS_ALLOWED_METHODS=DELETE,GET,HEAD,OPTIONS,PATCH,POST,PUT
SECURITY_CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Requested-With
SECURITY_CSRF_HEADER_NAME=X-Requested-With
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_RATE_LIMIT_FAIL_CLOSED=true
SECURITY_RATE_LIMIT_REDIS_TIMEOUT_SECONDS=0.5
SECURITY_RATE_LIMIT_AUTH_WRITE_MAX_REQUESTS=10
SECURITY_RATE_LIMIT_AUTH_WRITE_WINDOW_SECONDS=60
SECURITY_RATE_LIMIT_SEARCH_FEED_MAX_REQUESTS=30
SECURITY_RATE_LIMIT_SEARCH_FEED_WINDOW_SECONDS=60
SECURITY_RATE_LIMIT_WRITE_MAX_REQUESTS=60
SECURITY_RATE_LIMIT_WRITE_WINDOW_SECONDS=60
SECURITY_RATE_LIMIT_UPLOAD_MAX_REQUESTS=10
SECURITY_RATE_LIMIT_UPLOAD_WINDOW_SECONDS=60
SECURITY_RATE_LIMIT_ADMIN_MAX_REQUESTS=120
SECURITY_RATE_LIMIT_ADMIN_WINDOW_SECONDS=60

# Telegram crawler credentials + runtime knobs. Leave API id/hash blank locally so the
# Telethon adapter cannot hit real Telegram; pytest uses the in-process FakeTelegramClient.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_ENCRYPTION_SECRET=memexpert-dev-telegram-session-encryption-secret-change-me
CRAWLER_MAX_REQUESTS_PER_SECOND=15.0
CRAWLER_LIVE_MODE_ENABLED=true
CRAWLER_RECONCILE_INTERVAL_SECONDS=10.0
CRAWLER_FRESHNESS_SLO_P50_SECONDS=60.0
CRAWLER_FRESHNESS_SLO_P95_SECONDS=180.0
CRAWLER_DEFAULT_CATCHUP_MESSAGE_LIMIT=5000

# Scheduler process knobs. Set any *_ENABLED=false to disable a job. For local
# no-op/startup testing, disable every job and still run `uv run memexpert-scheduler`.
SCHEDULER_MATERIALIZED_VIEW_REFRESH_ENABLED=true
SCHEDULER_MATERIALIZED_VIEW_REFRESH_INTERVAL_SECONDS=300
SCHEDULER_SOURCE_ENGAGEMENT_CAPTURE_ENABLED=true
SCHEDULER_SOURCE_ENGAGEMENT_CAPTURE_INTERVAL_SECONDS=21600
SCHEDULER_SOURCE_ENGAGEMENT_CAPTURE_BATCH_SIZE=100
SCHEDULER_SOURCE_ENGAGEMENT_CAPTURE_PER_SESSION_BATCH_SIZE=20
SCHEDULER_SOURCE_ENGAGEMENT_CAPTURE_LEASE_TIMEOUT_SECONDS=1800
SCHEDULER_MOTD_ENABLED=true
SCHEDULER_MOTD_INTERVAL_SECONDS=86400
MOTD_ALGORITHM_VERSION=motd_v1
MOTD_CANDIDATE_LOOKBACK_DAYS=30
MOTD_CANDIDATE_LIMIT=50
MOTD_MIN_QUALITY_SCORE=0.5
MOTD_POPULARITY_WEIGHT=0.35
MOTD_TRENDING_GROWTH_WEIGHT=0.30
MOTD_NOVELTY_WEIGHT=0.20
MOTD_QUALITY_WEIGHT=0.15
SCHEDULER_SEARCH_INDEX_SYNC_ENABLED=true
SCHEDULER_SEARCH_INDEX_SYNC_INTERVAL_SECONDS=600
SCHEDULER_SEARCH_INDEX_SYNC_BATCH_SIZE=50
SCHEDULER_SEARCH_INDEX_SYNC_PROCESSING_TIMEOUT_SECONDS=900
SCHEDULER_SEO_BACKLOG_BATCHES_ENABLED=true
SCHEDULER_SEO_BACKLOG_BATCHES_INTERVAL_SECONDS=900
SCHEDULER_SEO_BACKLOG_BATCH_SIZE=25
SCHEDULER_RABBITMQ_OUTBOX_PUBLISHER_ENABLED=true
SCHEDULER_RABBITMQ_OUTBOX_PUBLISHER_INTERVAL_SECONDS=5
SCHEDULER_RABBITMQ_OUTBOX_PUBLISHER_BATCH_SIZE=100
SCHEDULER_RABBITMQ_OUTBOX_PUBLISHER_STALE_TIMEOUT_SECONDS=300
SCHEDULER_TELEGRAM_LOGIN_CLEANUP_ENABLED=true
SCHEDULER_TELEGRAM_LOGIN_CLEANUP_INTERVAL_SECONDS=60
SCHEDULER_TELEGRAM_LOGIN_CLEANUP_BATCH_SIZE=100
SCHEDULER_ADVISORY_LOCK_ENABLED=true
SCHEDULER_ADVISORY_LOCK_KEY=0,0

# Compose-only infrastructure credentials and admin defaults.
POSTGRES_USER=memexpert
POSTGRES_PASSWORD=memexpert
POSTGRES_DB=memexpert
RABBITMQ_DEFAULT_USER=memexpert
RABBITMQ_DEFAULT_PASS=memexpert
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=memexpert
