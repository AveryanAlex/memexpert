# Copy this file to .env for local development overrides.
# Docker Compose also ships with inline defaults, so the stack validates without a .env file.

APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=postgresql+asyncpg://memexpert:memexpert@localhost:5432/memexpert
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://memexpert:memexpert@localhost:5672/
QDRANT_URL=http://localhost:6333
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=memexpert-dev-key
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=memexpert
S3_SECRET_KEY=memexpert-secret
S3_BUCKET=memexpert
S3_REGION=us-east-1
IMGPROXY_BASE_URL=http://localhost:8080
IMGPROXY_PORT=8080

# Compose-only infrastructure credentials and admin defaults.
POSTGRES_USER=memexpert
POSTGRES_PASSWORD=memexpert
POSTGRES_DB=memexpert
RABBITMQ_DEFAULT_USER=memexpert
RABBITMQ_DEFAULT_PASS=memexpert
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=memexpert
