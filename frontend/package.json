    "@types/node": "^22.19.21",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.17.0",
    "bits-ui": "^2.18.1"
