# Copy to an untracked production env file and replace every change-me value.
# This file contains placeholders only so compose config validation can run in CI.

MEMEXPERT_APP_IMAGE=memexpert-app:prod
MEMEXPERT_FRONTEND_IMAGE=memexpert-frontend:prod
API_PORT=8000
FRONTEND_PORT=3000
FRONTEND_ORIGIN=https://memexpert.example.com

POSTGRES_USER=memexpert
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=memexpert
RABBITMQ_DEFAULT_USER=memexpert
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq-password
MEILISEARCH_MASTER_KEY=change-me-meilisearch-master-key-min-16

S3_ACCESS_KEY=memexpert
S3_SECRET_KEY=change-me-minio-secret-key-min-8
S3_BUCKET=memexpert
S3_REGION=us-east-1

# Generate high-entropy hex/base64 values for imgproxy signing in production.
IMGPROXY_KEY=change-me-imgproxy-key
IMGPROXY_SALT=change-me-imgproxy-salt
MEDIA_PUBLIC_BASE_URL=

PIPELINE_OPERATOR_TOKEN=change-me-pipeline-operator-token-min-32
PIPELINE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,video/mp4,video/quicktime,video/webm
PIPELINE_VOYAGE_API_KEY=
PIPELINE_CLASSIFICATION_API_URL=
PIPELINE_CLASSIFICATION_API_KEY=

AUTH_JWT_SECRET=change-me-auth-jwt-secret-min-32-bytes
AUTH_TELEGRAM_BOT_USERNAME=
AUTH_TELEGRAM_BOT_TOKEN=
AUTH_TELEGRAM_LINK_RETURN_URL=
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URI=

SECURITY_CORS_ALLOWED_ORIGINS=https://memexpert.example.com,https://web.telegram.org,https://oauth.telegram.org
SECURITY_CORS_ALLOWED_ORIGIN_REGEX=^https://([a-z0-9-]+\.)?memexpert\.example\.com$

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
